+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "jit.h"
+#if (!defined(__powerpc__) && !defined(__PPC__)) || defined(__powerpc64__)
+#error "JIT trampoline requires 32-bit PowerPC"
+#endif
+static_assert(sizeof(void*)==4, "32-bit ABI required");
+#define STR_I(x) #x
+#define STR(x) STR_I(x)
+// No .S rule is needed. Frame is 16-byte aligned and contains linkage space.
+// Preserve all r14-r31, LR and the full CR. r1/r2/r13 are never repurposed.
+// A native leaf returns with blr; it may not make helper calls in this stage.
+__asm__(
+    ".text\n"
+    ".align 2\n"
+    ".globl jitEnter\n"
+    ".type jitEnter,@function\n"
+    "jitEnter:\n"
+    "stwu 1,-112(1)\n"
+    "mflr 0\n"
+    "stw 0,92(1)\n"
+    "mfcr 0\n"
+    "stw 0,88(1)\n"
+    "stw 14,16(1)\n"
+    "stw 15,20(1)\n"
+    "stw 16,24(1)\n"
+    "stw 17,28(1)\n"
+    "stw 18,32(1)\n"
+    "stw 19,36(1)\n"
+    "stw 20,40(1)\n"
+    "stw 21,44(1)\n"
+    "stw 22,48(1)\n"
+    "stw 23,52(1)\n"
+    "stw 24,56(1)\n"
+    "stw 25,60(1)\n"
+    "stw 26,64(1)\n"
+    "stw 27,68(1)\n"
+    "stw 28,72(1)\n"
+    "stw 29,76(1)\n"
+    "stw 30,80(1)\n"
+    "stw 31,84(1)\n"
+    "mtctr 3\n"
+    "mr 30,4\n"
+    "lwz 31," STR(JIT_CTX_INTERPRETER) "(30)\n"
+    "lwz 14," STR(JIT_CTX_REGS) "+0(30)\n"
+    "lwz 15," STR(JIT_CTX_REGS) "+4(30)\n"
+    "lwz 16," STR(JIT_CTX_REGS) "+8(30)\n"
+    "lwz 17," STR(JIT_CTX_REGS) "+12(30)\n"
+    "lwz 18," STR(JIT_CTX_REGS) "+16(30)\n"
+    "lwz 19," STR(JIT_CTX_REGS) "+20(30)\n"
+    "lwz 20," STR(JIT_CTX_REGS) "+24(30)\n"
+    "lwz 21," STR(JIT_CTX_REGS) "+28(30)\n"
+    "lwz 22," STR(JIT_CTX_REGS) "+32(30)\n"
+    "lwz 23," STR(JIT_CTX_REGS) "+36(30)\n"
+    "lwz 24," STR(JIT_CTX_REGS) "+40(30)\n"
+    "lwz 25," STR(JIT_CTX_REGS) "+44(30)\n"
+    "lwz 26," STR(JIT_CTX_REGS) "+48(30)\n"
+    "lwz 27," STR(JIT_CTX_REGS) "+52(30)\n"
+    "lwz 28," STR(JIT_CTX_REGS) "+56(30)\n"
+    "lwz 29," STR(JIT_CTX_CPSR) "(30)\n"
+    "bctrl\n"
+    "stw 14," STR(JIT_CTX_REGS) "+0(30)\n"
+    "stw 15," STR(JIT_CTX_REGS) "+4(30)\n"
+    "stw 16," STR(JIT_CTX_REGS) "+8(30)\n"
+    "stw 17," STR(JIT_CTX_REGS) "+12(30)\n"
+    "stw 18," STR(JIT_CTX_REGS) "+16(30)\n"
+    "stw 19," STR(JIT_CTX_REGS) "+20(30)\n"
+    "stw 20," STR(JIT_CTX_REGS) "+24(30)\n"
+    "stw 21," STR(JIT_CTX_REGS) "+28(30)\n"
+    "stw 22," STR(JIT_CTX_REGS) "+32(30)\n"
+    "stw 23," STR(JIT_CTX_REGS) "+36(30)\n"
