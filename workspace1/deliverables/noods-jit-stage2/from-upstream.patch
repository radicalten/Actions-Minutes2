+    V("rlwinm 3,4,30,3,3",rlwinm(3,4,30,3,3));
+    V("rlwinm. 31,0,0,31,0",rlwinm(31,0,0,31,0,true));
+    V("rlwimi 3,4,30,3,3",rlwimi(3,4,30,3,3));
+    V("rlwimi. 31,0,0,31,0",rlwimi(31,0,0,31,0,true));
