+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+root=$PWD
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+python3 tools/jit_make_test_oracle.py "$work"
+python3 tools/jit_make_pipeline_test.py "$work"
+mkdir -p "$work/sd:/noods"
+for mode in native diff disabled oom; do
+    flags=()
+    sources=()
