diff --git a/tests/jit_native_test.cpp b/tests/jit_native_test.cpp
new file mode 100644
index 0000000..9fc14d6
--- /dev/null
+++ b/tests/jit_native_test.cpp
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "../NooDS-Wii/jit.h"
+#include "../NooDS-Wii/jit_compiler.h"
+#include "../NooDS-Wii/jit_cache.h"
+#include <sys/mman.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+extern "C" int jitReference(JitContext *,uint32_t,bool,bool);
+extern "C" int jitAbiProbe(JitEntry,JitContext *);
+static uint32_t rng=0x517493A7;
+static uint32_t randomWord() { rng^=rng<<13; rng^=rng>>17; rng^=rng<<5; return rng; }
+static const uint32_t edge[]={0,1,2,31,32,33,63,64,127,128,255,256,257,0x7FFFFFFF,0x80000000,0xFFFFFFFF};
+static unsigned long cases=0,armAccepted=0,thumbAccepted=0;
+static void run(JitEntry entry,uint32_t opcode,bool thumb,unsigned samples) {
+    for (unsigned sample=0;sample<samples;sample++) for (unsigned arm7=0;arm7<2;arm7++) {
+        JitContext native{};
+        for (unsigned r=0;r<16;r++) native.regs[r]=sample<16?edge[(sample+r)%16]:randomWord();
+        // Exercise every old-NZCV combination and deliberately varied low CPSR bits.
+        native.cpsr=(sample<16 ? sample<<28 : randomWord()&0xF0000000)|0x080000DF|(thumb?32:0);
+        JitContext reference=native;
+        if (jitReference(&reference,opcode,thumb,arm7)<0) {
+            std::printf("BAD_ALLOWLIST opcode=%08x thumb=%u\n",opcode,thumb); std::exit(1);
+        }
+        if (jitAbiProbe(entry,&native)) { std::puts("ABI_FAILURE"); std::exit(1); }
+        bool equal=native.cpsr==reference.cpsr && native.cycles==reference.cycles;
+        for (unsigned r=0;r<16;r++) equal &= native.regs[r]==reference.regs[r];
+        if (!equal) {
+            std::printf("NATIVE_FAIL op=%08x thumb=%u arm7=%u sample=%u cpsr=%08x/%08x cycles=%u/%u\n",
+                opcode,thumb,arm7,sample,native.cpsr,reference.cpsr,native.cycles,reference.cycles);
+            for(unsigned r=0;r<16;r++) std::printf("r%u=%08x/%08x\n",r,native.regs[r],reference.regs[r]);
+            std::exit(1);
+        }
+        cases++;
+    }
+}
+int main() {
+    void *memory=mmap(nullptr,4096,PROT_READ|PROT_WRITE|PROT_EXEC,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);
+    if(memory==MAP_FAILED) { std::perror("mmap"); return 1; }
+    uint32_t *code=static_cast<uint32_t*>(memory);
+    auto check=[&](uint32_t op,bool thumb,unsigned samples) {
+        JitPpc::Writer w(code,1024);
+        bool accepted=thumb?Jit::compileThumb(w,op):Jit::compileArm(w,op);
+        if(!accepted) { if(w.size()) { std::puts("REJECT_EMITTED_CODE"); std::exit(1); } return; }
+        if(!w.good()) std::abort();
+        if(thumb) thumbAccepted++; else armAccepted++;
+        __builtin___clear_cache(static_cast<char*>(memory),static_cast<char*>(memory)+w.size()*4);
+        run(reinterpret_cast<JitEntry>(memory),op,thumb,samples);
+    };
+    // Every THUMB encoding, including rejection of all unknown/branch/memory ops.
+    for(unsigned op=0;op<65536;op++) check(op,true,20);
+    // Every ARM dispatch slot with independent register/immediate low fields.
+    for(unsigned slot=0;slot<4096;slot++) for(unsigned sample=0;sample<16;sample++) {
+        uint32_t op=0xE0000000u|((slot&0xFF0)<<16)|((slot&15)<<4);
+        op|=randomWord()&0x000FFF0Fu;
+        check(op,false,20);
+    }
+    // Broader randomized ARM fields, conditions and shift amounts.
+    for(unsigned i=0;i<60000;i++) check(randomWord(),false,8);
+    // Content-addressed cache: exact opcode changes, CPU/ISA keys, negatives,
+    // collisions and arena wrap are exercised with a tiny arena in this test.
+    for(unsigned i=0;i<16000;i++) {
+        uint32_t op=0xE2800000u|(randomWord()&0x000EEFFFu);
+        JitEntry entry=Jit::lookup(op,false,i&1);
+        if(!entry) continue;
+        if(Jit::lookup(op,false,i&1)!=entry) std::abort();
+        run(entry,op,false,1);
+        if(Jit::lookup(0xE12FFF1Eu,false,false)) std::abort(); // BX must fall back.
+        if(Jit::lookup(0x10000u,true,false)) std::abort();
+    }
+    auto stats=Jit::cacheStats();
+    if(!stats.hits || !stats.flushes || !stats.rejected) std::abort();
+    std::printf("NATIVE_ORACLE_OK: %lu states; %lu THUMB encodings; %lu ARM candidates accepted\n",cases,thumbAccepted,armAccepted);
+    std::printf("CACHE_OK: hits=%u misses=%u compiled=%u flushes=%u rejected=%u\n",stats.hits,stats.misses,stats.compiles,stats.flushes,stats.rejected);
+    std::puts("ABI_OK: r14-r31, r2/r13 and full CR checked on every invocation");
+    munmap(memory,4096);
+}
diff --git a/tests/jit_pipeline_test.inc b/tests/jit_pipeline_test.inc
new file mode 100644
index 0000000..89dc127
--- /dev/null
+++ b/tests/jit_pipeline_test.inc
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Appended by jit_make_pipeline_test.py to the extracted execution code.
+static void fail(const char *text,uint32_t op) {
+    std::printf("PIPELINE_FAIL %s opcode=%08x\n",text,op); std::exit(1);
+}
+static void prepare(Interpreter &cpu,Core &core,uint32_t op,bool thumb,unsigned flags,bool unmapped,bool banked) {
+    unsigned width=thumb?2:4, address=4096-2*width;
+    if(banked) for(unsigned i=8;i<15;i++) cpu.registers[i]=&cpu.registersFiq[i-8];
+    for(unsigned i=0;i<15;i++) *cpu.registers[i]=0x78123456u+i*0x234567u;
+    cpu.cpsr=(flags<<28)|0xDF|(thumb?32:0);
+    cpu.cycles=0x123456; cpu.halted=0; cpu.dsiCycle=true;
+    *cpu.registers[15]=address+width;
+    cpu.pipeline[0]=op;
+    cpu.pipeline[1]=thumb ? 0x2112 : 0xE3A01012; // Prefetched MOV r1,#18.
+    // Memory deliberately differs from both prefetched instructions.
+    std::memset(core.memory.bytes,0xA5,sizeof(core.memory.bytes));
+    cpu.pcData=core.memory.bytes+address+width;
+    if(unmapped) {
+        core.memory.readMap9A[1]=nullptr; core.memory.readMap7[1]=nullptr;
+    }
+}
+int main() {
+    const uint32_t armOps[]={0xE3A02037,0xE2911001,0xE0812413,0xE1A002E3,0xE1A00263,
+        0xE2F11001,0xE0202391,0xE08000AF,0xE12FFF1E,0xFF000000};
+    const uint32_t thumbOps[]={0x2000,0x3101,0x1C89,0x4088,0x41C8,0x4248,0xB081,0x4508,
+        0x4348,0xDE00,0x4770};
+    unsigned checks=0;
+    for(unsigned thumb=0;thumb<2;thumb++) for(unsigned arm7=0;arm7<2;arm7++)
+    for(unsigned mapping=0;mapping<2;mapping++) for(unsigned banked=0;banked<2;banked++)
+    for(unsigned nzcv=0;nzcv<16;nzcv++) for(unsigned cond=0;cond<(thumb?1:16);cond++) {
+        unsigned count=thumb?sizeof(thumbOps)/4:sizeof(armOps)/4;
+        for(unsigned i=0;i<count;i++) {
+            uint32_t opcode=thumb?thumbOps[i]:((armOps[i]&0x0FFFFFFF)|(cond<<28));
+            Core ca,cb;
+            Interpreter reference(&ca,arm7),native(&cb,arm7);
+            prepare(reference,ca,opcode,thumb,nzcv,mapping,banked);
+            prepare(native,cb,opcode,thumb,nzcv,mapping,banked);
+            for(unsigned step=0;step<2;step++) {
+                unsigned f=fallbackCalls,h=reservedCalls;
+                Settings::jitEnabled=0; int expected=reference.runOpcode();
+                unsigned expectedFallback=fallbackCalls-f,expectedReserved=reservedCalls-h;
+                f=fallbackCalls;h=reservedCalls;
+                Settings::jitEnabled=1; int actual=native.runOpcode();
+                if(actual!=expected || native.cpsr!=reference.cpsr) fail("cycles/flags",opcode);
+                for(unsigned r=0;r<16;r++) if(*native.registers[r]!=*reference.registers[r]) fail("register",opcode);
+                if(std::memcmp(native.pipeline,reference.pipeline,sizeof(native.pipeline))) fail("prefetch",opcode);
+                if(ca.memory.reads!=cb.memory.reads) fail("read side effect",opcode);
+                if((native.pcData==nullptr)!=(reference.pcData==nullptr)) fail("pointer null",opcode);
+                if(native.pcData && native.pcData-cb.memory.bytes!=reference.pcData-ca.memory.bytes) fail("pointer offset",opcode);
+                if(native.cycles!=reference.cycles || native.halted!=reference.halted || native.dsiCycle!=reference.dsiCycle) fail("scheduler fields",opcode);
+                if(fallbackCalls-f!=expectedFallback || reservedCalls-h!=expectedReserved) fail("fallback count",opcode);
+                checks++;
+            }
+        }
+    }
+#ifndef NOODS_NO_JIT
+    auto stats=Jit::cacheStats();
+#ifdef JIT_TEST_ALLOC_FAIL
+    if(stats.compiles || !stats.misses) fail("OOM cache state",0);
+    std::puts("OOM_FALLBACK_OK: all native allocations denied; reference execution preserved");
+#else
+    if(!stats.compiles || !stats.hits || !stats.rejected) fail("no cache activity",0);
+#endif
+#ifdef JIT_DIFFTEST
+    // Intentionally corrupt a REFERENCE dispatch slot to test first-mismatch
+    // reporting, reference-state retention and permanent native disablement.
+    Core core; Interpreter cpu(&core,false);
+    prepare(cpu,core,0xE3A02037,false,0,false,false);
+    Interpreter::armInstrs[0x3A3]=&Interpreter::unkArm; // MOV immediate index for 0x37
+    uint32_t savedR0=*cpu.registers[0],savedR2=*cpu.registers[2];
+    int cycles=-1;
+    if(!Jit::execute(cpu,0xE3A02037,false,cycles) || cycles!=3) fail("fault result",0);
+    if(*cpu.registers[0]!=(savedR0^0xE3A02037u) || *cpu.registers[2]!=savedR2) fail("reference state not retained",0);
+    int unused=99;
+    if(Jit::execute(cpu,0xE3A01012,false,unused) || unused!=99) fail("fault not latched",0);
+    FILE *log=std::fopen("sd:/noods/jit_log.txt","r");
+    if(!log) fail("no mismatch log",0);
+    char text[512]={};std::fread(text,1,sizeof(text)-1,log);std::fclose(log);
+    if(!std::strstr(text,"opcode=e3a02037")) fail("mismatch log content",0);
+    std::puts("DIFFTEST_FAULT_OK: injected mismatch logged; reference retained; native disabled");
+#endif
+#endif
+    std::printf("PIPELINE_OK: %u step comparisons; runtime toggle, condition checks, banked pointers, page crossings and prefetched stale bytes\n",checks);
+}
diff --git a/tools/jit_generate_decode.py b/tools/jit_generate_decode.py
new file mode 100755
index 0000000..74f7d93
--- /dev/null
+++ b/tools/jit_generate_decode.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""Generate the native ALU allowlist from the real ARM dispatch table.
+Check this file into source control; run with --check to reject table drift.
+"""
+import pathlib,re,sys,hashlib
+root=pathlib.Path(__file__).resolve().parent.parent
+raw=(root/'NooDS-Wii/interpreter_lookup.cpp').read_text()
+body=re.search(r'Interpreter::armInstrs\[\]\)\(uint32_t\)\s*=\s*\{(.*?)\};',raw,re.S).group(1)
+body=re.sub(r'//[^\n]*','',body)
+names=re.findall(r'&Interpreter::(\w+)',body)
+assert len(names)==4096
+pairs=[('_and','ands'),('eor','eors'),('sub','subs'),('rsb','rsbs'),('add','adds'),('adc','adcs'),('sbc','sbcs'),('rsc','rscs'),(None,'tst'),(None,'teq'),(None,'cmp'),(None,'cmn'),('orr','orrs'),('mov','movs'),('bic','bics'),('mvn','mvns')]
+classes={}
+for op,pair in enumerate(pairs):
+ for flag,base in enumerate(pair):
+  if base:
+   for suffix in ['Lli','Llr','Lri','Lrr','Ari','Arr','Rri','Rrr','Imm']:
+    classes[base+suffix]=op*2+flag+1
+values=[classes.get(n,0) for n in names]
+text='// SPDX-License-Identifier: GPL-3.0-or-later\n// Generated by tools/jit_generate_decode.py; do not edit.\n'
+text+='// Dispatch-name SHA256: '+hashlib.sha256('\n'.join(names).encode()).hexdigest()+'\n'
+text+='static const uint8_t armAluClass[4096] = {\n'
+text+=''.join('    '+', '.join(str(x) for x in values[i:i+16])+',\n' for i in range(0,len(values),16))
+text+='};\n'
+path=root/'NooDS-Wii/jit_decode_arm.inc'
+if '--check' in sys.argv:
+ if not path.exists() or path.read_text()!=text: raise SystemExit('ARM decode table drift; regenerate/review')
+else:path.write_text(text)
+print('ARM_DECODE_OK:',sum(x!=0 for x in values),'native-eligible table slots (PC operands still excluded)')
diff --git a/tools/jit_make_pipeline_test.py b/tools/jit_make_pipeline_test.py
new file mode 100755
index 0000000..899efb3
--- /dev/null
+++ b/tools/jit_make_pipeline_test.py
@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Use exact runOpcode/getOpcode source with a small test memory backend.
+This tests integration boundaries, NOT the full Core/event queue/MMIO system.
+"""
+import pathlib,re,sys
+root=pathlib.Path(__file__).resolve().parent.parent
+out=pathlib.Path(sys.argv[1])
+lookup=(root/'NooDS-Wii/interpreter_lookup.cpp').read_text()
+interpreter=(root/'NooDS-Wii/interpreter.cpp').read_text()
+alu=(root/'NooDS-Wii/interpreter_alu.cpp').read_text()
+methods=set(re.findall(r'int Interpreter::(\w+)\(uint(?:16|32)_t opcode',alu))
+for name in re.findall(r'^ALU_FUNCS\((\w+),',alu,re.M):
+ for suffix in ['Lli','Llr','Lri','Lrr','Ari','Arr','Rri','Rrr','Imm']:methods.add(name+suffix)
+s='#include "'+str(root/'NooDS-Wii/jit.h')+'"\n'
+s+='#define private public\n#include "'+str(root/'NooDS-Wii/interpreter.h')+'"\n#undef private\n'
+s+='#include "'+str(root/'NooDS-Wii/settings.h')+'"\n'
+s+='#include "'+str(root/'NooDS-Wii/jit_cache.h')+'"\n'
+s+='''#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cstddef>
+struct TestMemory {
+ alignas(32) uint8_t bytes[8192] = {};
+ uint8_t *readMap9A[2] = {bytes,bytes+4096};
+ uint8_t *readMap7[2] = {bytes,bytes+4096};
+ unsigned reads=0;
+ template<typename T> T read(bool,uint32_t address) {
+  ++reads; if(address+sizeof(T)>sizeof(bytes)) std::abort();
+  T v=0; for(unsigned i=0;i<sizeof(T);i++) v|=uint32_t(bytes[address+i])<<(8*i);
+  return v;
+ }
+};
+class Core { public: TestMemory memory; };
+int Settings::jitEnabled=0;
+static unsigned fallbackCalls=0,reservedCalls=0;
+int Interpreter::unkArm(uint32_t opcode) { ++fallbackCalls; *registers[0]^=opcode; return 3; }
+int Interpreter::unkThumb(uint16_t opcode) { ++fallbackCalls; *registers[0]^=opcode; return 3; }
+int Interpreter::handleReserved(uint32_t) { ++reservedCalls; return 7; }
+'''
+for mode,bits,length in [('arm',32,4096),('thumb',16,1024)]:
+ body=re.search(r'Interpreter::'+mode+r'Instrs\[\]\)\(uint'+str(bits)+r'_t\)\s*=\s*\{(.*?)\};',lookup,re.S).group(1)
+ names=re.findall(r'&Interpreter::(\w+)',re.sub(r'//[^\n]*','',body));assert len(names)==length
+ fallback='unkArm' if mode=='arm' else 'unkThumb'
+ s+=f'int (Interpreter::*Interpreter::{mode}Instrs[{length}])(uint{bits}_t) = {{\n'
+ s+=''.join('&Interpreter::'+(name if name in methods else fallback)+',\n' for name in names)+'};\n'
+m=re.search(r'const uint8_t Interpreter::condition\[256\]\s*=\s*\{.*?\};',lookup,re.S);s+=m.group(0)+'\n'
+for prefix in ['FORCE_INLINE int Interpreter::runOpcode()', 'uint16_t Interpreter::getOpcode16()', 'uint32_t Interpreter::getOpcode32()']:
+ start=interpreter.index(prefix);brace=interpreter.index('{',start);depth=1;end=brace+1
+ while depth:
+  if interpreter[end]=='{':depth+=1
+  elif interpreter[end]=='}':depth-=1
+  end+=1
+ s+=interpreter[start:end]+'\n'
+s+=(root/'tests/jit_pipeline_test.inc').read_text()
+(out/'pipeline.cpp').write_text(s)
+print('PIPELINE_SOURCE_OK: exact runOpcode/getOpcode bodies and condition table; instrumented memory/fallbacks')
diff --git a/tools/jit_make_test_oracle.py b/tools/jit_make_test_oracle.py
